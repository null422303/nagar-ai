# Copy to .env and fill in your keys

# DashScope — supports MULTIPLE keys for round-robin + auto-retry.
# Separate with commas. On quota/429/5xx, the client rotates to the next key.
DASHSCOPE_API_KEYS=your_dashscope_key_1,your_dashscope_key_2,your_dashscope_key_3
# (or a single key for backwards compatibility)
# DASHSCOPE_API_KEY=your_dashscope_key

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENROUTER_API_KEY=your_openrouter_key
